# Copy this file to .env and fill in what you have. Everything here is OPTIONAL —
# cutting, captions, color, Shorts, and the review page all work with no keys.

# Best-quality transcription (word-level timing). Free tier works. https://elevenlabs.io
ELEVENLABS_API_KEY=

# OPTIONAL: auto-scheduling via Buffer (ve_post.py). Most people skip this and
# native-upload from the review page instead (better reach).
# BUFFER_ACCESS_TOKEN=
